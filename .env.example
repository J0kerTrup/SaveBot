BOT_TOKEN=
# Instagram: cookies.txt (формат Netscape) с sessionid отдельного аккаунта, которым владелец вправе управлять
COOKIES_FILE=
# Файлы больше 50 МБ — по MTProto под токеном бота (до 2 ГБ): api_id и api_hash с my.telegram.org. Пусто — лимит 50 МБ
API_ID=
API_HASH=
# Частей файла в полёте при загрузке по MTProto
MTPROTO_WINDOW=8
# Spotify: сколько треков альбома или плейлиста присылать в личке и в группе
PLAYLIST_PRIVATE=50
PLAYLIST_GROUP=10
# 1 — к видео присылать ещё и трек отдельным файлом, 0 — только видео (трек — если видео нет)
SEND_AUDIO=1
PARALLEL_DOWNLOADS=3
PER_CHAT_PER_MINUTE=6
# Подпись под файлами; по умолчанию «📥 @имя_бота»
CAPTION=
